<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.characteratlas.archipelago.catalog.infrastructure.OptionsMapper">
  <select id="awakened" resultType="boolean">
    SELECT EXISTS (SELECT 1 FROM voyager_growth WHERE character_id = #{id} AND awakened)
  </select>
</mapper>
